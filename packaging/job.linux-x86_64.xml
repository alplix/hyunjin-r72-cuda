<job_desc>
  <task>
    <application>dnetc_hyunjin_1.0_linux_x86_64</application>
    <checkpoint_filename>chkpoint</checkpoint_filename>
    <command_line>-ini dnetc.ini -runoffline -multiok=1</command_line>
    <priority>3</priority>
  </task>
</job_desc>