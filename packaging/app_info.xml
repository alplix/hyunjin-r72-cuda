<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  Hyunjin - modern CUDA-C RC5-72 core for distributed.net / Moo! Wrapper
  Coded by Alperen Yavuz

  Moo! Wrapper anonymous-application descriptor.

  This app_info.xml is for the Moo! Wrapper NVIDIA OpenCL app
  (opencl_nvidia_101, version 1.05) and our custom dnetc client with the
  Hyunjin CUDA-C core.  The wrapper binary below is Moo's stock BOINC
  wrapper for that app; job.xml tells it to launch our client, and our
  dnetc.ini selects the Hyunjin core ([rc5-72] core = 5).

  Place this file (plus all referenced binaries/ini/job files) in:

      <boinc>/projects/moowrap.net/

  For use in distributed.net projects only.
  Any other distribution or use of this source violates copyright.
-->
<app_info>
  <app>
    <name>dnetc</name>
    <user_friendly_name>Distributed.net Client</user_friendly_name>
  </app>

  <!-- Moo! Wrapper - BOINC wrapper binary (NVIDIA OpenCL, 1.05) that
       orchestrates the dnetc client.  Matches the server app version. -->
  <file_info>
    <name>dnetc_wrapper_1.5_windows_intelx86__opencl_nvidia_101.exe</name>
    <executable/>
  </file_info>

  <!-- Custom distributed.net client with the Hyunjin core compiled in -->
  <file_info>
    <name>dnetc_hyunjin_1.0_windows_x86_64.exe</name>
    <executable/>
  </file_info>

  <!-- Our job.xml + dnetc.ini take the place of Moo's app-level job/ini files.
       Without these file_refs the BOINC client would stage Moo's stock
       dnetc.ini (which has no [rc5-72] core=5 line), silently disabling the
       Hyunjin core.  copy_file puts a working copy in each job slot. -->
  <file_info>
    <name>job.xml</name>
  </file_info>
  <file_info>
    <name>dnetc.ini</name>
  </file_info>

  <app_version>
    <app_name>dnetc</app_name>
    <version_num>105</version_num>
    <platform>windows_intelx86</platform>
    <avg_ncpus>0.1</avg_ncpus>
    <max_ncpus>1</max_ncpus>
    <plan_class>opencl_nvidia_101</plan_class>
    <flops>100000000000.0</flops>
    <file_ref>
      <file_name>dnetc_wrapper_1.5_windows_intelx86__opencl_nvidia_101.exe</file_name>
      <main_program/>
    </file_ref>
    <file_ref>
      <file_name>dnetc_hyunjin_1.0_windows_x86_64.exe</file_name>
      <copy_file/>
    </file_ref>
    <file_ref>
      <file_name>job.xml</file_name>
      <open_name>job.xml</open_name>
      <copy_file/>
    </file_ref>
    <file_ref>
      <file_name>dnetc.ini</file_name>
      <open_name>dnetc.ini</open_name>
      <copy_file/>
    </file_ref>

    <!-- NVIDIA GPU availability (matches the server app's coproc deployment):
         one NVIDIA device per job slot. -->
    <coproc>
      <type>NVIDIA</type>
      <count>1</count>
    </coproc>
  </app_version>
</app_info>